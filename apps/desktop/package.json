{
  "name": "@theseus/desktop",
  "version": "0.1.0",
  "private": true,
  "description": "Electron shell for Theseus: window, sandboxed local files, open in Excel/Word.",
  "type": "module",
  "main": "dist/main.js",
  "scripts": {
    "dev": "node scripts/run.mjs dev",
    "start": "node scripts/run.mjs prod",
    "build": "node scripts/run.mjs build",
    "typecheck": "tsc -p tsconfig.json",
    "icon": "node scripts/make-icon.mjs",
    "bundle": "node scripts/run.mjs dist"
  },
  "devDependencies": {
    "@theseus/core": "workspace:*",
    "@theseus/kaveri": "workspace:*",
    "@theseus/web": "workspace:*",
    "electron": "^44.5.1",
    "electron-builder": "^25.1.8",
    "esbuild": "^0.25.0",
    "playwright-core": "1.56.1",
    "vite": "^6.4.0"
  },
  "author": "Theseus",
  "homepage": "https://github.com/theseus-mini"
