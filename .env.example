# Model providers (only one is needed to start; the Gemini free tier is fine early on)
GEMINI_API_KEY=
ANTHROPIC_API_KEY=

# Which provider the employees use: gemini | anthropic (anthropic arrives at M7)
MODEL_PROVIDER=gemini

# Gemini model and free-tier limits (requests per minute / per day)
GEMINI_MODEL=gemini-3.5-flash-lite
GEMINI_RPM=15
GEMINI_RPD=500
